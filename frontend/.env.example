# Achuppori Frontend Configuration
# ==========================================
# Configurable backend base URL for API requests.
#
# For Cloudflare Tunnel testing:
#   BACKEND_URL=https://your-tunnel-name.trycloudflare.com/api
#   or
#   BACKEND_URL=https://your-tunnel-name.trycloudflare.com
#
# For Local Server / Static LAN IP testing:
#   BACKEND_URL=http://127.0.0.1:8000/api
#   or
#   BACKEND_URL=http://192.168.1.100:8000/api
#
BACKEND_URL=http://127.0.0.1:8000/api
