AGENT_ID=PRINT-SERVER-001
# Backend API base URL.
# For Cloudflare Tunnel testing: BACKEND_URL=https://your-tunnel-name.trycloudflare.com/api
# For Local Server / Static IP:  BACKEND_URL=http://127.0.0.1:8000/api or http://192.168.1.100:8000/api
BACKEND_URL=http://127.0.0.1:8000/api
AGENT_TOKEN=CHANGE_ME_AGENT_DEVICE_TOKEN
STORAGE_ROOT=/var/lib/printplatform/storage

POLL_INTERVAL_SECONDS=3
HEARTBEAT_INTERVAL_SECONDS=15

CUPS_SERVER=localhost
