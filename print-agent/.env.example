# ==============================================================================
# Autonomous Printer - Print Agent Station Configuration Template
# Production Target: Raspberry Pi 3 Model B (Low CPU/Memory 24/7 Deployment)
# ==============================================================================

# Unique station identifier matching the backend database
AGENT_ID=PRINT-SERVER-001

# Central backend server endpoint (e.g. http://192.168.1.100:8000/api)
BACKEND_URL=http://192.168.1.100:8000/api

# Station device authentication token matching the backend database
AGENT_TOKEN=CHANGE_ME_AGENT_DEVICE_TOKEN

# Token required for direct backend dispatch requests (/local/print-job)
INTERNAL_AGENT_TOKEN=CHANGE_ME_INTERNAL_TOKEN

# Local storage and spool paths
STORAGE_ROOT=./storage
LOG_DIR=./logs

# Intervals tuned for low CPU usage on Raspberry Pi 3 Model B (seconds)
POLL_INTERVAL_SECONDS=10
HEARTBEAT_INTERVAL_SECONDS=30
BACKOFF_MAX_SECONDS=30

# Memory and SSD safety thresholds
MIN_FREE_DISK_MB=200
MAX_CACHE_JOBS=100

# Physical CUPS printer settings
CUPS_SERVER=localhost
PRINTER_NAME=Default_Office_Printer
PORT=5001

# Set to false in production on Raspberry Pi with physical printer
MOCK_CUPS=false
