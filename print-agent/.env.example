AGENT_ID=PRINT-SERVER-001
BACKEND_URL=http://127.0.0.1:8000/api
# Independent random token of 32+ chars; store only its SHA-256 in print_servers.
AGENT_TOKEN=
# Same protected storage as the backend. Use an absolute path in deployment.
STORAGE_ROOT=../backend/storage
STATE_ROOT=./state
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
POLL_INTERVAL_SECONDS=3
HEARTBEAT_INTERVAL_SECONDS=15
CUPS_SERVER=localhost
PRINTER_NAME=Default_Office_Printer
# True only for local test simulation; backend must also allow it.
MOCK_CUPS=false
