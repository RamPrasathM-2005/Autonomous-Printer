# Register this station in admin first; copy its ID and unique device token.
AGENT_ID=PRINT-SERVER-001
AGENT_TOKEN=CHANGE_ME_AGENT_DEVICE_TOKEN
BACKEND_URL=http://127.0.0.1:8000/api
# Public/LAN frontend address encoded in this station's QR.
KIOSK_WEB_URL=http://127.0.0.1:3000
MOCK_CUPS=false
CUPS_SERVER=localhost
# Leave empty for automatic discovery; assigned jobs carry the exact CUPS queue.
PRINTER_NAME=
HOST=127.0.0.1
PORT=5001
# Paths are relative to print-agent/, independent of the launch directory.
STORAGE_ROOT=./storage
LOG_DIR=./logs
