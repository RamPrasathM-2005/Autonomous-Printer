[Unit]
Description=Achuppori central API
After=network-online.target
Wants=network-online.target

[Service]
User=achuppori
WorkingDirectory=/opt/achuppori/backend
EnvironmentFile=/opt/achuppori/backend/.env
ExecStart=/opt/achuppori/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
