APP_NAME=QwikPrint
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000

# Use a dedicated MySQL user; URL-encode special password characters.
DATABASE_URL=mysql+pymysql://print_user:REPLACE_PASSWORD@127.0.0.1:3306/printer

# Independent random values, never committed. JWT/OTP_HASH: secrets.token_urlsafe(48).
JWT_SECRET_KEY=
OTP_HASH_KEY=
# Generate with cryptography.fernet.Fernet.generate_key().decode().
OTP_ENCRYPTION_KEY=

STORAGE_ROOT=./storage
MAX_UPLOAD_MB=50
MAX_DOCUMENT_PAGES=500
MAX_ORDER_PAGES=1000
MAX_SESSION_STORAGE_MB=200
DOCUMENT_TTL_HOURS=24
SESSION_TTL_HOURS=24
OTP_TTL_MINUTES=30

# INR; the backend is authoritative.
PER_PAGE_RATE=2.00
COLOR_PAGE_RATE=10.00
BASE_FEE=0.00

# Genuine Razorpay TEST keys first; webhook secret is independently configured.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_HTTP_TIMEOUT=10
RECONCILE_INTERVAL_SECONDS=30

ALLOWED_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
ALLOWED_HOSTS=["127.0.0.1","localhost"]
# Only true for Windows test runs with rzp_test_ keys. False for physical printing/live.
ALLOW_MOCK_PRINTING=false
ALLOW_UNPAID_TEST_PRINTING=false
HEARTBEAT_TIMEOUT_SECONDS=60
