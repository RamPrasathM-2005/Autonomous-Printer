APP_NAME=Achuppori
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=sqlite:///./test_print_platform.db
# Production MySQL URL:
# DATABASE_URL=mysql+pymysql://print_user:CHANGE_ME@127.0.0.1:3306/print_platform

# Auth
JWT_SECRET_KEY=CHANGE_ME_SUPER_SECRET_KEY_AT_LEAST_32_CHARS
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# File Storage
STORAGE_ROOT=./storage
MAX_UPLOAD_MB=50

# OTP & Retries
OTP_TTL_MINUTES=30
MAX_OTP_ATTEMPTS=5
MAX_PRINT_RETRIES=2

# Pricing Defaults (in INR)
PER_PAGE_RATE=2.50
BASE_FEE=1.00

# Razorpay
RAZORPAY_KEY_ID=rzp_test_key_id
RAZORPAY_KEY_SECRET=rzp_test_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret

# Timeouts
AGENT_REQUEST_TIMEOUT_SECONDS=10
HEARTBEAT_TIMEOUT_SECONDS=60

# Initial Admin & Seed Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisSuperSecurePassword123!
ADMIN_NAME=Platform Administrator

# Demo Student Credentials (Optional / Seed)
DEMO_STUDENT_EMAIL=student@example.com
DEMO_STUDENT_PASSWORD=StudentPass123!
DEMO_STUDENT_NAME=Demo Student

# Print Server Defaults
INTERNAL_AGENT_TOKEN=CHANGE_ME_AGENT_DEVICE_TOKEN
DEFAULT_PRINT_SERVER_ID=PRINT-SERVER-001
DEFAULT_PRINT_SERVER_NAME=Central Library Station
DEFAULT_PRINT_SERVER_LOCATION=Main Campus Library Floor 1
