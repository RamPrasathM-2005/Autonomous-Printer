# Central server only. Keep this file private.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./print_platform.db
JWT_SECRET_KEY=CHANGE_ME_SUPER_SECRET_KEY_AT_LEAST_32_CHARS
STORAGE_ROOT=./storage
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Platform Administrator
# Required for payments and signed webhooks.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Required for email OTP login.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Achuppori Cloud Print
# Optional operational defaults; other settings already have code defaults.
PER_PAGE_RATE=2.50
BASE_FEE=1.00
HEARTBEAT_TIMEOUT_SECONDS=120
